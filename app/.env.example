# OpenAI (required — the agent pipeline and chat cannot run without this)
OPENAI_API_KEY=

# Optional overrides
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Langfuse observability (optional — leave blank to run fully offline with
# a no-op tracer; the app degrades gracefully, only tracing is disabled)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Local storage paths (relative to the app/ directory when run with
# `uvicorn backend.main:app` from app/)
DATABASE_PATH=./data/cis.db
CHROMA_PERSIST_DIR=./data/chroma_db
UPLOAD_DIR=./data/uploads

# Session cookie signing secret — change this for any non-local use
SESSION_SECRET=dev-only-change-me

# Pipeline thresholds
EXTRACTION_CONFIDENCE_THRESHOLD=0.6
INSIGHT_CONFIDENCE_THRESHOLD=0.65
